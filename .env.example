# Example environment variables for the agent subsystem.
#
# PLACEHOLDER VALUES ONLY — never commit a real credential to this file.
# Copy the entries you need into your own `.env` (which is gitignored for real
# values) and fill them in there.
#
# This file documents only the agent-specific variables added by the agent
# subsystem. See README.md for the base platform's configuration (database,
# Redis, Celery, email, model serving).


# ─── Upstream LLM provider ───────────────────────────────────────────────────
#
# Per merge decision 6 there is no hardcoded provider. Each `agent_profile` row
# names its own `base_url` + `api_key_ref` + `model`, and the only requirement
# is that the endpoint speaks the OpenAI-compatible chat-completions wire
# format. Ollama, Groq, OpenRouter, vLLM and OpenAI all qualify.
#
# Keys are NEVER stored in the database. A profile stores `api_key_ref`, the
# *name* of an environment variable, and the key is read from the environment
# at request time — so dumping the profile table cannot leak a credential.

# Fallback upstream, used when a profile leaves `base_url` empty.
# Defaults to a local Ollama instance, which needs no key and costs nothing.
AGENT_UPSTREAM_BASE_URL=http://localhost:11434/v1

# Fallback API key, used when a profile leaves `api_key_ref` empty.
# Safe to leave blank for local providers that don't authenticate.
AGENT_UPSTREAM_API_KEY=

# Per-provider keys. Create one variable per provider you use and point the
# matching profile's `api_key_ref` at its name. The seeded default profiles
# reference OLLAMA_API_KEY, AGENT_UPSTREAM_API_KEY and OPENAI_API_KEY.
OLLAMA_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here


# ─── Codex Responses API ─────────────────────────────────────────────────────
#
# Codex speaks OpenAI's proprietary Responses API rather than chat-completions,
# so it is handled as a special-cased normalization path. When a Codex profile
# targets a non-OpenAI base_url, the proprietary fields are rewritten; when it
# targets OpenAI, the payload is forwarded largely as-is.

# Optional operator override for reasoning effort, e.g. to cap cost.
# Valid values: low | medium | high. Leave blank to let Codex decide (with a
# clamp applied for models that reject its default).
AGENT_REASONING_EFFORT=
